# Per-run trace directories are intentionally not committed.
# They are regenerated by paper/icns3-2026-tcp-aqm/scripts/run_tcp_aqm_sweep.py.
# Only the per-campaign summary CSVs at the top of each campaign directory,
# the derived evaluation tables, and the reference figures are tracked.

# Ignore every per-run subdirectory under each campaign root.
single-flow/*/
mixed-flow/*/
smoke/config-sweep/*/
smoke/mixed-flow/*/
smoke/topology/*/

# Re-allow the per-campaign summary CSVs at the top of each campaign directory.
!single-flow/summary.csv
!single-flow/summary-aggregate.csv
!single-flow/summary-selected.csv
!single-flow/summary-selected-aggregate.csv
!mixed-flow/summary.csv
!mixed-flow/summary-aggregate.csv
!mixed-flow/summary-selected.csv
!mixed-flow/summary-selected-aggregate.csv
!smoke/config-sweep/summary.csv
!smoke/config-sweep/summary-aggregate.csv
!smoke/config-sweep/summary-selected.csv
!smoke/config-sweep/summary-selected-aggregate.csv
!smoke/mixed-flow/summary.csv
!smoke/mixed-flow/summary-aggregate.csv
!smoke/topology/summary.csv
!smoke/topology/summary-aggregate.csv
